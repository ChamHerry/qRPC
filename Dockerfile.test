FROM golang:1.25-bookworm

SHELL ["/bin/bash", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal

ENV PATH="/opt/qrpc-venv/bin:/root/.cargo/bin:${PATH}"

RUN cargo install just --locked

RUN python3 -m venv /opt/qrpc-venv \
    && /opt/qrpc-venv/bin/python3 -m pip install --upgrade pip \
    && /opt/qrpc-venv/bin/python3 -m pip install maturin pytest

WORKDIR /work
COPY . .

CMD ["bash", "-c", "just verify && just test-interop && cargo run -p qrpc-rust-example && python3 examples/python/hello.py && cargo build -p qrpc-core && go run ./examples/go"]
